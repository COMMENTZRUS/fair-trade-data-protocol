{
  "name": "@ftdp/contracts",
  "version": "0.1.0",
  "description": "Fair Trade Data Protocol (FTDP) smart contracts: SLS AccessPermissions, Market, and hardened Constant-Time MultiSplitter Data Unions",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "compile:solc": "node scripts/compile-solc.js",
    "test": "hardhat test",
    "test:evm": "node scripts/compile-solc.js && node scripts/run-evm-tests.js",
    "deploy:local": "hardhat run scripts/deploy.ts",
    "deploy:dry-run": "node scripts/deploy-live-evm.js --network gnosisChiado --with-3tier-union --dry-run",
    "deploy:gnosis-chiado": "node scripts/deploy-live-evm.js --network gnosisChiado --with-3tier-union",
    "deploy:gnosis": "node scripts/deploy-live-evm.js --network gnosis --with-3tier-union",
    "deploy:sepolia": "node scripts/deploy-live-evm.js --network sepolia --with-3tier-union"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "ethers": "^6.13.4"
  }
}
