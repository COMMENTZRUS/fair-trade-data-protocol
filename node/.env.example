PORT=4000
HOST=0.0.0.0
FTDP_STORAGE_DRIVER=defradb
DEFRADB_URL=http://127.0.0.1:9181
DEFRA_KEYRING_SECRET=change-me-32-byte-secret
FTDP_DATA_DIR=/data
FTDP_SEED_DEMO=false
FTDP_PII_MASTER_KEY=change-me-32-byte-kms-master-key
FTDP_API_KEY=change-me-node-api-key
FTDP_JWT_SECRET=change-me-jwt-secret
FTDP_CORS_ORIGIN=https://fairtradedata.org
FTDP_SOLANA_CLUSTER=devnet
FTDP_SOLANA_OWNER_PUBKEY=
FTDP_API_DOMAIN=api.fairtradedata.org
FTDP_ENABLE_WORKERS=true
FTDP_MERKLE_INTERVAL_MS=300000
FTDP_METERING_INTERVAL_MS=600000
FTDP_REAPER_INTERVAL_MS=60000
# Optional EVM bridge (Gnosis Chain = 100, Chiado = 10200, Ethereum = 1)
FTDP_RPC_URL=
FTDP_CHAIN_ID=100
FTDP_CLIENT_CONFIG_ADDRESS=
FTDP_ACCESS_PERMISSIONS_ADDRESS=
FTDP_OPERATOR_PRIVATE_KEY=
